{
  "name": "state-machine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "vue-tsc": "vue-tsc --noEmit",
    "lint": "eslint . --ext .js,.ts,.vue",
    "lint:fix": "eslint . --ext .js,.ts,.vue --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,js,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,js,json,css,md}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@xstate/vue": "^5.0.1",
    "pinia": "^4.0.3",
    "vue": "^3.5.13",
    "xstate": "^5.19.2"
  },
  "devDependencies": {
    "@pinia/testing": "^0.1.7",
    "@types/node": "^20.19.43",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^9.33.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.2.0"
  }
}
